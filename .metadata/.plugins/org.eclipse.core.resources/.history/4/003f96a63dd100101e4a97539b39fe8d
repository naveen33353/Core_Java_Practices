//	4.return all person who are older than 25 yrs
	
	public Set<Person> getPersonOlderThan25() {
		Set <Person> result1 =new HashSet<>();
		for(Person p : persons) {
			if(p.getAge()>25) {
				result1.add(p);	
			}
			
		}
		return result1;
	}
	
//	5. All person working in given city
	
	public void getPersonWorkingInCity(String city) {
		
		boolean found = false;
		for(Person p : persons) {
			if(p.workAddress.city.name.equals(city)) {
				found = true;
				System.out.println(p);
			}
		}
		if(!found) {
			System.out.println("persons working at "+ city + " are not found");
		}
		
	}
	
//	6. All persons Working in same city and older tha 20

	public Set<Person> getPersonWorkingInCityAndNotOlderThan20(String city) {
		
		Set<Person> result2 = new HashSet<>();
		
		for(Person p : persons) {
			if(p.workAddress.city.name.equalsIgnoreCase(city) && p.getAge()<=20) {
				result2.add(p);
			}
		}
		return result2;
	}
	
	
