//   3.1	groped by city
	
	public void listByCity() {
		HashMap<City, ArrayList<Person>> map1 = new HashMap<>(); //map creation
		
		for(Person p : persons ) { //loop through persons list
			City city = p.homeAddress.city; //getting city from person class using homeaddress
			map1.putIfAbsent(city, new ArrayList<>());
			map1.get(city).add(p);
		}
		
		for(City city : map1.keySet()) {
			System.out.println("City : "+ city);
			System.out.println("********************************");
			
			for(Person p : map1.get(city)) {
				System.out.println(" "+ p);
				System.out.println();
			}
		}
	}
	
//	3.2   grouped by country
	
	public HashMap<Country, ArrayList<Person>> listByCountry() {
		HashMap <Country, ArrayList<Person>> map2 = new HashMap<>();
		
		for(Person p : persons) {
			Country country = p.homeAddress.country;
			map2.putIfAbsent(country, new ArrayList<>());
		    map2.get(country).add(p); 
		}
		for(Country country: map2.keySet()) {
			System.out.println("Country :  "+ country);
			System.out.println("************************************");
			
			for(Person p : map2.get(country)) {
				System.out.println(" "+ p);
				System.out.println(); 
			}
		}
		return map2;
	}
	
